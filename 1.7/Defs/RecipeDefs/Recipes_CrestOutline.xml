<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Base Install Crest Outline Recipe -->
	<RecipeDef Name="InstallCrestOutline" Abstract="True">
		<workerClass>RJW_Unleashed_Crests.Recipe_InstallCrestOutline</workerClass>
		<anesthetize>false</anesthetize>
		<hideBodyPartNames>true</hideBodyPartNames>
		<jobString>Drawing a crest outline.</jobString>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Artistic</workSkill>
		<workSkillLearnFactor>1</workSkillLearnFactor>
		<workAmount>800</workAmount>
		<recipeUsers>
			<li>Human</li>
		</recipeUsers>
		<skillRequirements>
			<Artistic>2</Artistic>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Dye</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<appliedOnFixedBodyParts>
			<li>Torso</li>
		</appliedOnFixedBodyParts>
	</RecipeDef>
	
	<RecipeDef ParentName="InstallCrestOutline">
		<defName>InstallCrestOutline_Incubation</defName>
		<label>Draw crest outline of Incubation</label>
		<description>Draw a crest outline of incubation onto the pubic region.</description>
		<descriptionHyperlinks>
			<HediffDef>AppliedCrestOutline_Incubation</HediffDef>
		</descriptionHyperlinks>
		<addsHediff>AppliedCrestOutline_Incubation</addsHediff>
	</RecipeDef>
	
	<RecipeDef ParentName="InstallCrestOutline">
		<defName>InstallCrestOutline_Debauchery</defName>
		<label>Draw crest outline of Debauchery</label>
		<description>Draw a crest outline of debauchery onto the pubic region.</description>
		<descriptionHyperlinks>
			<HediffDef>AppliedCrestOutline_Debauchery</HediffDef>
		</descriptionHyperlinks>
		<addsHediff>AppliedCrestOutline_Debauchery</addsHediff>
	</RecipeDef>
	
	<RecipeDef ParentName="InstallCrestOutline">
		<defName>InstallCrestOutline_Breeding</defName>
		<label>Draw crest outline of Breeding</label>
		<description>Draw a crest outline of breeding onto the pubic region.</description>
		<descriptionHyperlinks>
			<HediffDef>AppliedCrestOutline_Breeding</HediffDef>
		</descriptionHyperlinks>
		<addsHediff>AppliedCrestOutline_Breeding</addsHediff>
	</RecipeDef>

	<RecipeDef ParentName="InstallCrestOutline">
		<defName>InstallCrestOutline_Vigor</defName>
