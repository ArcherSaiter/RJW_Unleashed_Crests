<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="VEF.PatchOperationToggableSequence">
    <enabled>True</enabled>
    <label>RJW Crests: enforce spawn of cosmetic crests</label>
    <operations>

      <li Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationTest">
            <success>Invert</success>
            <xpath>Defs/CultureDef/styleItemTags/li[tag='TattooRJWCrest']</xpath>
          </li>
          <li Class="PatchOperationInsert">
            <order>Append</order>
            <xpath>Defs/CultureDef/styleItemTags/li[last()]</xpath>
            <value>
              <li>
                <tag>TattooRJWCrest</tag>
                <baseWeight>0.01</baseWeight>
                <weightFactor>1</weightFactor>
              </li>
            </value>
          </li>
        </operations>
      </li>

      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/CultureDef[not(styleItemTags)]</xpath>
        <value>
          <styleItemTags>
            <li>
              <tag>TattooRJWCrest</tag>
              <baseWeight>0.01</baseWeight>
              <weightFactor>1</weightFactor>
            </li>
          </styleItemTags>
        </value>
      </li>

      <li Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationTest">
            <success>Invert</success>
            <xpath>Defs/MemeDef/styleItemTags/li[tag='TattooRJWCrest']</xpath>
          </li>
          <li Class="PatchOperationInsert">
            <order>Append</order>
            <xpath>Defs/MemeDef/styleItemTags/li[last()]</xpath>
            <value>
              <li>
                <tag>TattooRJWCrest</tag>
                <baseWeight>0.01</baseWeight>
                <weightFactor>1</weightFactor>
              </li>
            </value>
          </li>
        </operations>
      </li>

      <li Class="PatchOperationAdd">
        <success>Always</success>
        <xpath>Defs/MemeDef[not(styleItemTags)]</xpath>
        <value>
          <styleItemTags>
            <li>
              <tag>TattooRJWCrest</tag>
              <baseWeight>0.01</baseWeight>
              <weightFactor>1</weightFactor>
            </li>
          </styleItemTags>
        </value>
      </li>

    </operations>
  </Operation>
</Patch>
